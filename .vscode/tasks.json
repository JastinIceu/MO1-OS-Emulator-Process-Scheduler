{
    // builds main.cpp into csopesy.exe using the WinLibs g++ (has thread support)
    // -static bakes the runtime into the exe so it never grabs the old MinGW dlls
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build CSOPESY",
            "command": "C:/winlibs/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-g",
                "-static",
                "${workspaceFolder}/main.cpp",
                "-o",
                "${workspaceFolder}/csopesy.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "PATH": "C:\\winlibs\\bin;${env:PATH}" }
            },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        }
    ]
}
